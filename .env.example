# ---------------------------------------------------------------------------
# RAG Knowledge Platform - environment template
# Copy to `.env` at the repo root. Every value has a working default, so the
# app boots with an EMPTY .env in fully-free "demo" mode.
# ---------------------------------------------------------------------------

# --- LLM ---------------------------------------------------------------
# Leave blank to run in deterministic demo mode (no cost, no key needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4000

# --- Embeddings & retrieval ----------------------------------------------
# hashing (zero-dependency, default) | sentence-transformers (better recall)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24
RERANK_PROVIDER=heuristic
# cross-encoder (better, heavier install) | heuristic (zero-dependency default)

# --- Guardrails ------------------------------------------------------------
GROUNDEDNESS_THRESHOLD=0.5
BLOCK_ON_PROMPT_INJECTION=true

# --- App ---------------------------------------------------------------
APP_ENV=local
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins (e.g. your own Vercel preview URLs).
CORS_ORIGIN_REGEX=
# When set, document upload/delete require an X-Admin-Token header with this
# value. Blank = open demo mode. Querying always stays open.
ADMIN_TOKEN=
SERVE_FRONTEND=true
