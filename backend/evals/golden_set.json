    {
      "id": "vendor-access-timebox",
      "query": "How long is privileged access to the tokenisation service granted for?",
      "document": "Vendor Security Assessment",
      "must_contain": [
        "8 hours"
      ],
      "must_not_contain": []
    },
    {
      "id": "guidelines-report",
      "query": "Who should employees report a suspected prompt-injection attempt to?",
      "document": "Ai Tooling Usage Guidelines",
      "must_contain": [
        "security@example.com"
      ],
      "must_not_contain": []
    },
    {
      "id": "guidelines-review-cycle",
      "query": "How often is the AI tooling usage guideline reviewed?",
      "document": "Ai Tooling Usage Guidelines",
      "must_contain": [
        "six months"
      ],
      "must_not_contain": []
