{
  "description": "Golden evaluation set for the RAG Knowledge Platform, over the seeded demo corpus (a revenue report, a technical spec, a vendor security assessment, and an AI-tooling security guideline).",
  "cases": [
    {
      "id": "revenue-total",
      "query": "What was Meridian's total Q2 2026 revenue and year-over-year growth rate?",
      "document": "Q2 2026 Revenue Report",
      "must_contain": [
        "$18.4 million",
        "22%"
      ],
      "must_not_contain": [
        "$20 million",
        "30%"
      ]
    },
    {
      "id": "revenue-arr",
      "query": "What was the annual recurring revenue at the end of Q2 2026?",
      "document": "Q2 2026 Revenue Report",
      "must_contain": [
        "$71.6 million"
      ],
      "must_not_contain": []
    },
    {
      "id": "revenue-guidance",
      "query": "What is the Q3 2026 revenue guidance range?",
      "document": "Q2 2026 Revenue Report",
      "must_contain": [
        "$19.6 million",
        "$20.1 million"
      ],
      "must_not_contain": []
    },
    {
      "id": "revenue-region",
      "query": "Which region grew fastest year over year in Q2 2026?",
      "document": "Q2 2026 Revenue Report",
      "must_contain": [
        "EMEA",
        "27%"
      ],
      "must_not_contain": []
    },
    {
      "id": "revenue-magic-number",
      "query": "What was the magic number in Q2 2026?",
      "document": "Q2 2026 Revenue Report",
      "must_contain": [
        "0.83"
      ],
      "must_not_contain": []
    },
    {
