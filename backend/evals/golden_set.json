      "document": "Project Atlas Technical Spec",
      "must_contain": [
        "90 seconds"
      ],
      "must_not_contain": []
    },
    {
      "id": "atlas-checkpoint-interval",
      "query": "How often does the Flink job checkpoint?",
      "document": "Project Atlas Technical Spec",
      "must_contain": [
        "60-second",
        "Google Cloud Storage"
      ],
      "must_not_contain": []
    },
    {
      "id": "atlas-oncall-paging",
      "query": "At what consumer lag threshold does on-call get paged?",
      "document": "Project Atlas Technical Spec",
      "must_contain": [
        "100,000 messages"
      ],
      "must_not_contain": []
    },
    {
      "id": "atlas-cost",
      "query": "What is the monthly cost increase for the new streaming architecture?",
      "document": "Project Atlas Technical Spec",
      "must_contain": [
        "$11,100"
      ],
      "must_not_contain": []
    },
    {
      "id": "atlas-partitions",
      "query": "How many Kafka partitions does the atlas.events.v2 topic have?",
      "document": "Project Atlas Technical Spec",
      "must_contain": [
        "48 partitions"
      ],
      "must_not_contain": []
    },
    {
      "id": "vendor-rating",
      "query": "What is Brightline's overall risk rating?",
      "document": "Vendor Security Assessment",
      "must_contain": [
        "Low-Medium"
      ],
      "must_not_contain": []
    },
    {
      "id": "vendor-notification-sla",
      "query": "What incident notification SLA does Brightline currently commit to, and what does our standard require?",
      "document": "Vendor Security Assessment",
      "must_contain": [
        "72 hours",
        "24 hours"
      ],
      "must_not_contain": []
    },
    {
      "id": "vendor-pci",
      "query": "What PCI DSS certification level does Brightline hold?",
      "document": "Vendor Security Assessment",
      "must_contain": [
        "Level 1"
      ],
      "must_not_contain": []
    },
    {
      "id": "vendor-rto-rpo",
      "query": "What are Brightline's RTO and RPO?",
      "document": "Vendor Security Assessment",
      "must_contain": [
        "15 minutes",
        "5 minutes"
      ],
      "must_not_contain": []
